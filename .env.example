# Copy to .env and fill in. Never commit the real file.
#
# Write it as UTF-8. PowerShell's `>` and Out-File default to UTF-16 on
# Windows, and python-dotenv fails outright on a UTF-16 file.

# Required: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional overrides (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# CHROMA_DIR=./chroma_db
# MOCK_TODAY=2026-09-17
# PORT=8000
