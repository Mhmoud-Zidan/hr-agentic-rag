# Copy to .env and fill in. Never commit the real file.
#
# Write it as UTF-8. PowerShell's `>` and Out-File default to UTF-16 on
# Windows, and python-dotenv fails outright on a UTF-16 file.

# The LLM provider. Any OpenAI-compatible endpoint works; set the matching key.
# Default is groq.
# LLM_PROVIDER=groq          # groq | openrouter | openai

# Groq -- https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# OpenRouter -- https://openrouter.ai/keys
# Useful as a second provider when one is rate limited:
#   python evaluation/run_eval.py --provider openrouter
# OPENROUTER_API_KEY=sk-or-v1-your_key_here

# OpenAI -- https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your_key_here

# Any other OpenAI-compatible endpoint
# LLM_BASE_URL=https://example.com/v1
# LLM_API_KEY=your_key_here
# LLM_MODEL=model-id

# Optional overrides (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# CHROMA_DIR=./chroma_db
# MOCK_TODAY=2026-09-17
# PORT=8000
